{
  "name": "@pixec/burrow",
  "version": "0.1.0",
  "description": "TypeScript SDK for burrow - run AI agent code in Firecracker microVMs",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync-protos": "cp ../../crates/burrow-proto/proto/*.proto proto/",
    "build": "npm run sync-protos && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test 'test/*.test.mjs'",
    "example": "node examples/quickstart.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
