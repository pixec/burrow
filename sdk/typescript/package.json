{
  "name": "@pixec/burrow",
  "version": "0.1.0",
  "description": "TypeScript client for Burrow, self-hosted microVM sandboxes for running untrusted code",
  "license": "MIT",
  "author": "Pixec Technologies <oss+burrow@pixec.net>",
  "homepage": "https://burrow.pixec.net",
  "keywords": ["sandbox", "microvm", "firecracker", "cloud-hypervisor", "agents"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync-protos": "cp ../../crates/burrow-proto/proto/api.proto ../../crates/burrow-proto/proto/common.proto proto/",
    "build": "npm run sync-protos && tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "example": "node examples/quickstart.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
