+        let paused_sync = self.common.paused_sync.clone();
+        self.common.spawn_worker(
+            &self.id,
+            &self.seccomp_action,
+            Thread::VirtioInput,
+            &self.exit_evt,
+            device_status,
+            interrupt_cb,
+            move || handler.run(&paused, paused_sync.as_ref().unwrap()),
+        )?;
