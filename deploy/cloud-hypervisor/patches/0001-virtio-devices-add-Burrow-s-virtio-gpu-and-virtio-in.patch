+                let _ = self.host_evt.read();
+                if self.deliver()? {
+                    self.signal(0)?;
+                }
+            }
+            QUEUE_1_EVENT => {
+                let _ = self.status_evt.read();
+                if self.drain_status()? {
+                    self.signal(1)?;
+                }
+            }
+            other => return Err(handler_error("unexpected event", other)),
+        }
+        Ok(())
+    }
