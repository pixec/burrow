+    fn activate(&mut self, context: ActivationContext) -> ActivateResult {
+        let ActivationContext {
+            mem,
+            interrupt_cb,
+            mut queues,
+            device_status,
+        } = context;
+        self.common.activate(&queues, Arc::clone(&interrupt_cb))?;
+        let (kill_evt, pause_evt) = self.common.dup_eventfds()?;
+        let (_, events, events_evt) = queues.remove(0);
+        let (_, status, status_evt) = queues.remove(0);
+        let mut handler = InputHandler {
+            mem,
+            events,
+            status,
+            events_evt,
+            status_evt,
+            host_evt: self
