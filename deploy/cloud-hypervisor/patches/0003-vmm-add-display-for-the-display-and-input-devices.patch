+    fn make_display_devices(&mut self, snapshot: Option<&Snapshot>) -> DeviceManagerResult<()> {
+        let Some(config) = self.config.lock().unwrap().display.clone() else {
+            return Ok(());
+        };
+        info!(
+            "Creating display devices: {}x{} on {}",
+            config.width,
+            config.height,
+            config.socket.display()
+        );
+        let [gpu, keyboard, tablet] = DISPLAY_DEVICE_NAMES;
+        let states = DisplayStates {
+            gpu: state_from_id(snapshot, gpu).map_err(DeviceManagerError::RestoreGetState)?,
+            keyboard: state_from_id(snapshot, keyboard)
+                .map_err(DeviceManagerError::RestoreGetState)?,
+            tablet: state_from_id(snapshot, tablet).map_err(DeviceManagerError::RestoreGetState)?,
+        };
+        let devices = new_display(
+            DISPLAY_DEVICE_NAMES.map(String::from),
+            config.width,
+            config.height,
+            &config.socket,
+            &self.seccomp_action,
+            &self.exit_evt,
+            &states,
+        )
+        .map_err(DeviceManagerError::CreateDisplay)?;
+        self.add_display_device(gpu, devices.gpu);
+        self.add_display_device(keyboard, devices.keyboard);
+        self.add_display_device(tablet, devices.tablet);
+        Ok(())
+    }
+
+    fn add_display_device<T>(&mut self, id: &str, device: T)
+    where
+        T: virtio_devices::VirtioDevice + Migratable + 'static,
+    {
+        let device = Arc::new(Mutex::new(device));
+        self.virtio_devices.push(MetaVirtioDevice {
+            virtio_device: Arc::clone(&device) as Arc<Mutex<dyn virtio_devices::VirtioDevice>>,
+            pci_common: PciDeviceCommonConfig {
+                id: Some(id.to_string()),
+                ..Default::default()
+            },
+            dma_handler: None,
+        });
+        self.device_tree.lock().unwrap().insert(
+            id.to_string(),
+            DeviceNode::new(id.to_string(), Some(device)),
+        );
+    }
+
     fn make_vdpa_device(
         &mut self,
         vdpa_cfg: &mut VdpaConfig,
