+impl DisplayConfig {
+    pub const SYNTAX: &'static str = "Display and input devices \
+        \"width=<pixels>,height=<pixels>,socket=</path/to/a/socket>\"";
+
+    pub fn parse(display: &str) -> Result<Self> {
+        let mut parser = OptionParser::new();
+        parser.add("width").add("height").add("socket");
+        parser.parse(display).map_err(Error::ParseDisplay)?;
+        let width = parser
+            .convert::<u32>("width")
+            .map_err(Error::ParseDisplay)?
+            .ok_or(Error::ParseDisplayMissing)?;
+        let height = parser
+            .convert::<u32>("height")
+            .map_err(Error::ParseDisplay)?
+            .ok_or(Error::ParseDisplayMissing)?;
+        let socket = parser
+            .get("socket")
+            .map(PathBuf::from)
+            .ok_or(Error::ParseDisplayMissing)?;
+        if !is_valid_mode(width, height) {
+            return Err(Error::ParseDisplayMissing);
+        }
+        Ok(DisplayConfig {
+            width,
+            height,
+            socket,
+        })
+    }
+}
